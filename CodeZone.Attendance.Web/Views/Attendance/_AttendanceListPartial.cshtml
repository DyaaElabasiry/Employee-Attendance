@using CodeZone.Attendance.Data.Models
@using CodeZone.Attendance.Web.ViewModels
@model PagedResult<AttendanceListViewModel>

<div class="card">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-list-ul"></i> Attendance Records</h5>
        <span class="badge bg-light text-dark">Total: @Model.TotalCount records</span>
    </div>
    <div class="card-body">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr data-attendance-id="@item.Id">
                                <td>@item.EmployeeName</td>
                                <td>@item.DepartmentName</td>
                                <td>@item.Date.ToString("MMM dd, yyyy (dddd)")</td>
                                <td>
                                    @if (item.Status == CodeZone.Attendance.Data.Entities.AttendanceStatus.Present)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> @item.StatusDisplay
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle"></i> @item.StatusDisplay
                                        </span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-danger btn-sm delete-attendance" data-id="@item.Id">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <nav aria-label="Attendance pagination">
                <ul class="pagination justify-content-center">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link pagination-link" href="#" data-page="@(Model.Page - 1)">Previous</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">Previous</span>
                        </li>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link pagination-link" href="#" data-page="@i">@i</a>
                        </li>
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link pagination-link" href="#" data-page="@(Model.Page + 1)">Next</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">Next</span>
                        </li>
                    }
                </ul>
            </nav>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle"></i> No attendance records found matching your criteria.
            </div>
        }
    </div>
</div>