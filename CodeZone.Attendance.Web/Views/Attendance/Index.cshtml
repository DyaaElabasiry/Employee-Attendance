@{
    ViewData["Title"] = "Attendance Management";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="mx-auto" style="max-width: 80%;">
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-body-secondary text-black">
                <h5 class="mb-0"><i class="bi bi-calendar-check"></i> Mark Attendance</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label for="quickEmployeeSelect" class="form-label">Select Employee</label>
                            <select id="quickEmployeeSelect" class="form-select">
                                <option value="">-- Select Employee --</option>
                                @if (ViewBag.Employees != null)
                                {
                                    @foreach (var emp in ViewBag.Employees)
                                    {
                                        <option value="@emp.Id">@emp.FullName (@emp.DepartmentName)</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label for="quickDatePicker" class="form-label">Select Date</label>
                            <input type="date" id="quickDatePicker" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label class="form-label">Current Status</label>
                            <div id="currentStatusDisplay" class="alert alert-info">
                                <strong>Not marked</strong>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <button type="button" id="markPresentBtn" class="btn btn-success me-2">
                            <i class="bi bi-check-circle"></i> Mark Present
                        </button>
                        <button type="button" id="markAbsentBtn" class="btn btn-danger me-2">
                            <i class="bi bi-x-circle"></i> Mark Absent
                        </button>
                        <button type="button" id="clearSelectionBtn" class="btn btn-secondary">
                            <i class="bi bi-arrow-counterclockwise"></i> Clear
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-body-secondary text-black">
                <h5 class="mb-0"><i class="bi bi-funnel"></i> Filter Attendance Records</h5>
            </div>
            <div class="card-body">
                <form id="filterForm">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group mb-3">
                                <label for="filterDepartment" class="form-label">Department</label>
                                <select id="filterDepartment" name="departmentId" class="form-select">
                                    <option value="">-- All Departments --</option>
                                    @if (ViewBag.Departments != null)
                                    {
                                        @foreach (var dept in ViewBag.Departments)
                                        {
                                            <option value="@dept.Id" selected="@(dept.Id == ViewBag.DepartmentId)">@dept.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group mb-3">
                                <label for="filterEmployee" class="form-label">Employee</label>
                                <select id="filterEmployee" name="employeeId" class="form-select">
                                    <option value="">-- All Employees --</option>
                                    @if (ViewBag.Employees != null)
                                    {
                                        @foreach (var emp in ViewBag.Employees)
                                        {
                                            <option value="@emp.Id" selected="@(emp.Id == ViewBag.EmployeeId)">@emp.FullName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group mb-3">
                                <label for="filterStartDate" class="form-label">Start Date</label>
                                <input type="date" id="filterStartDate" name="startDate" class="form-control" value="@ViewBag.StartDate" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group mb-3">
                                <label for="filterEndDate" class="form-label">End Date</label>
                                <input type="date" id="filterEndDate" name="endDate" class="form-control" value="@ViewBag.EndDate" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group mb-3">
                                <label class="form-label">&nbsp;</label>
                                <button type="button" id="applyFilterBtn" class="btn btn-primary w-100">
                                    <i class="bi bi-search"></i> Apply Filter
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <button type="button" id="clearFilterBtn" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-x"></i> Clear Filters
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="attendanceListContainer">
    <!-- Attendance list will be loaded here via AJAX -->
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
</div>
</div>
@section Scripts {
    <script src="~/js/attendance.js" asp-append-version="true"></script>
}